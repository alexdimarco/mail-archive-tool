<?xml version="1.0" encoding="UTF-8"?>
<!--
  MailArchive Desktop MSI — in-repo WiX source.

  SourceDir ($(var.SourceDir)) is the UNZIPPED payload that packaging/build-release.sh
  produces as the release asset `mailarchive-desktop-windows-msi-payload.zip`:

      mailarchive.exe              the console build of the one program (CLI / headless engine)
      mailarchivew.exe             the no-console build; `mailarchivew.exe desktop` is the dashboard + reader, `mailarchivew.exe wizard` the wizard
      mailarchive-desktop.exe      a former name: a byte-identical copy of mailarchivew.exe, kept this release (§7.1)
      mailarchive-gui.exe          a former name: a byte-identical copy of mailarchivew.exe, kept this release (§7.1)
      PRODUCT-VERSION.txt          the release tag the MSI binds ProductVersion to (MA-614)
      READ ME.txt                  payload readme (packaging/.../README-payload.txt)
      branding\mailarchive.ico     app icon
      docs\LICENSE.txt             AGPL-3.0
      docs\release-notes.md, docs\goback.md, docs\graph-app-setup.md

  Build-MSI.ps1 stages four more files into SourceDir before the build:
      SOURCE-NOTICE.txt, DEPLOYMENT.txt, THIRD-PARTY-NOTICES.md,
      managed-install.marker, and the generated PAYLOAD-SHA256.txt.

  DC6 — clean upgrade over Steve's out-of-repo 1.1.0 build: the UpgradeCode below is
  IDENTICAL to his and the detection key is the same HKLM\Software\MailArchive Desktop,
  so any ProductVersion > 1.1.0 performs a MajorUpgrade that removes his build and
  installs this one in its place. DO NOT change the UpgradeCode.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <Product
      Id="*"
      Name="MailArchive Desktop"
      Language="1033"
      Version="$(var.ProductVersion)"
      Manufacturer="MailArchive Desktop"
      UpgradeCode="4CE5B43F-D4D0-59ED-9BCB-4A004F0F2D11">

    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64" />
    <!-- Shared UpgradeCode + higher version => silent replace of any earlier build
         (Steve's 1.1.0 included). Scheduled early so old files are gone first. -->
    <MajorUpgrade
        Schedule="afterInstallInitialize"
        DowngradeErrorMessage="A newer version of MailArchive Desktop is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- An instance that ran before this version keeps serving its old dashboard (no
         private link, a fixed address) until its user signs out, in every session of
         an RDS host or fast-user-switching machine. End it before the files are
         replaced: ask it to close, and terminate it (exit code 1) if it does not —
         the same end Uninstall-RMM.ps1 and Install-RMM.ps1 give it
         (design-local-confidentiality CC22). Needs WixUtilExtension (Build-MSI.ps1
         passes -ext). -->
    <util:CloseApplication
        Id="CloseMailArchiveDesktop"
        Target="mailarchive-desktop.exe"
        CloseMessage="no"
        EndSessionMessage="no"
        RebootPrompt="no"
        TerminateProcess="1" />

    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPCONTACT" Value="IT Support" />
    <Property Id="ARPHELPLINK" Value="https://github.com/alexdimarco/mail-archive-tool" />
    <Condition Message="MailArchive Desktop requires 64-bit Windows.">VersionNT64</Condition>

    <Icon Id="MailArchiveIcon" SourceFile="$(var.SourceDir)\branding\mailarchive.ico" />
    <Property Id="ARPPRODUCTICON" Value="MailArchiveIcon" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="MailArchive Desktop">
          <Directory Id="DocsDir" Name="docs" />
        </Directory>
      </Directory>
      <!-- All-users shortcut destinations. DesktopFolder, StartupFolder and
           ProgramMenuFolder are standard Windows Installer system folders; a perMachine
           install (ALLUSERS=1) resolves them to the all-users Desktop, Startup and Programs
           locations. (Earlier builds used CommonDesktopFolder and similar shell CSIDL
           names, which are not installer properties, so the shortcuts were written to the
           target-volume root instead of where the user can see them.) -->
      <Directory Id="DesktopFolder" Name="Desktop" />
      <Directory Id="StartupFolder" Name="Startup" />
      <Directory Id="ProgramMenuFolder" Name="Programs">
        <Directory Id="ApplicationProgramsFolder" Name="MailArchive Desktop" />
      </Directory>
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <!-- The console build of the one program. Used for app-only / multi-mailbox
           scheduled captures and headless CLI use; the dashboard's weekly backup runs
           in-process as mailarchivew.exe desktop -capture (DC1), never a child. -->
      <Component Id="CmpEngineExe" Guid="*" Win64="yes">
        <File Id="FilEngineExe" Source="$(var.SourceDir)\mailarchive.exe" KeyPath="yes" />
      </Component>

      <!-- The no-console build of the one program (-H=windowsgui). `mailarchivew.exe
           desktop` serves the dashboard and reader in-process, each on a free loopback
           port behind a private one-time link (P1); `mailarchivew.exe wizard` is the
           wizard. Carries every schedule and shortcut after SE2 (§7.1). -->
      <Component Id="CmpGuiwExe" Guid="*" Win64="yes">
        <File Id="FilGuiwExe" Source="$(var.SourceDir)\mailarchivew.exe" KeyPath="yes" />
      </Component>

      <!-- Two former-name copies of mailarchivew.exe (byte-identical), kept from
           release N until the floor (§7.1) so shortcuts and schedules installed under
           the old names keep running; a later release removes them. Each is a plain
           single-file component with a versioned keypath (D3). -->
      <Component Id="CmpDesktopCopyExe" Guid="*" Win64="yes">
        <File Id="FilDesktopCopyExe" Source="$(var.SourceDir)\mailarchive-desktop.exe" KeyPath="yes" />
      </Component>

      <Component Id="CmpGuiCopyExe" Guid="*" Win64="yes">
        <File Id="FilGuiCopyExe" Source="$(var.SourceDir)\mailarchive-gui.exe" KeyPath="yes" />
      </Component>

      <Component Id="CmpBrandAssets" Guid="*" Win64="yes">
        <File Id="FilIcon" Source="$(var.SourceDir)\branding\mailarchive.ico" KeyPath="yes" />
      </Component>

      <!-- Deployment metadata + payload manifest + AGPL source/notices, flat in the
           install dir. DEPLOYMENT.txt / SOURCE-NOTICE.txt / THIRD-PARTY-NOTICES.md /
           managed-install.marker are staged by Build-MSI.ps1; READ ME.txt ships in
           the payload zip. Explicit, stable GUID: a multi-file component with no versioned
           keypath cannot use an auto GUID (WiX LGHT0367). -->
      <Component Id="CmpDeploymentDocs" Guid="A02C9F1E-19B8-4E17-B6C1-8F6410E7A224" Win64="yes">
        <File Id="FilDeployment" Source="$(var.SourceDir)\DEPLOYMENT.txt" KeyPath="yes" />
        <File Id="FilReadme" Source="$(var.SourceDir)\READ ME.txt" />
        <File Id="FilPayloadHash" Source="$(var.SourceDir)\PAYLOAD-SHA256.txt" />
        <File Id="FilManagedMarker" Source="$(var.SourceDir)\managed-install.marker" />
        <File Id="FilSourceNotice" Source="$(var.SourceDir)\SOURCE-NOTICE.txt" />
        <File Id="FilThirdParty" Source="$(var.SourceDir)\THIRD-PARTY-NOTICES.md" />
      </Component>

      <Component Id="CmpShortcutsAndDetection" Guid="*" Win64="yes">
        <!-- DC6 detection key: unchanged from Steve's build. -->
        <RegistryKey Root="HKLM" Key="Software\MailArchive Desktop">
          <RegistryValue Name="Installed" Type="integer" Value="1" KeyPath="yes" />
          <RegistryValue Name="Version" Type="string" Value="$(var.ProductVersion)" />
          <RegistryValue Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" />
        </RegistryKey>

        <!-- Shortcuts target the no-console build mailarchivew.exe with an explicit
             `desktop` verb (the dashboard surface of the one program). It is
             windowsgui (no console); on a normal start it opens the dashboard in the
             OS default browser itself (MA-281), so a Desktop/Start-menu click shows
             the page instead of a silent background server. The MailArchive wizard
             shortcut runs `mailarchivew.exe wizard` (SC20). -->
        <Shortcut
            Id="DesktopShortcut"
            Directory="DesktopFolder"
            Name="MailArchive Desktop"
            Description="Open MailArchive Desktop"
            Target="[INSTALLFOLDER]mailarchivew.exe"
            Arguments="desktop"
            WorkingDirectory="INSTALLFOLDER"
            Icon="MailArchiveIcon"
            Advertise="no" />

        <!-- ADAPTED: Steve's Startup shortcut passed a startup flag (our binary had
             no such flag; the two hyphens of it are left out here, an XML comment may not hold them). It now passes -no-browser so the at-login launch starts
             the always-on background server QUIETLY — no browser tab every sign-in. A
             later Desktop/Start-menu click reconnects to this account's instance — once
             it has proved itself — and has it open the browser (MA-281, MA-376). -->
        <Shortcut
            Id="StartupShortcut"
            Directory="StartupFolder"
            Name="MailArchive Desktop"
            Description="Start MailArchive Desktop after Windows sign-in"
            Target="[INSTALLFOLDER]mailarchivew.exe"
            Arguments="desktop -no-browser"
            WorkingDirectory="INSTALLFOLDER"
            Icon="MailArchiveIcon"
            Advertise="no" />

        <Shortcut
            Id="StartMenuShortcut"
            Directory="ApplicationProgramsFolder"
            Name="MailArchive Desktop"
            Description="Open MailArchive Desktop"
            Target="[INSTALLFOLDER]mailarchivew.exe"
            Arguments="desktop"
            WorkingDirectory="INSTALLFOLDER"
            Icon="MailArchiveIcon"
            Advertise="no" />

        <!-- The wizard's Start-menu click route (SC20): mailarchivew.exe wizard. -->
        <Shortcut
            Id="WizardShortcut"
            Directory="ApplicationProgramsFolder"
            Name="MailArchive wizard"
            Description="Open the MailArchive setup wizard"
            Target="[INSTALLFOLDER]mailarchivew.exe"
            Arguments="wizard"
            WorkingDirectory="INSTALLFOLDER"
            Icon="MailArchiveIcon"
            Advertise="no" />

        <!-- A way in that needs no OS browser opener: shows a fresh private link in a
             dialog with a Copy button (a broken default-browser association, a
             blocked opener). The locked page names it (design-local-confidentiality
             CC20). -->
        <Shortcut
            Id="CopyLinkShortcut"
            Directory="ApplicationProgramsFolder"
            Name="Copy MailArchive link"
            Description="Show a link that opens MailArchive Desktop in the browser of your choice"
            Target="[INSTALLFOLDER]mailarchivew.exe"
            Arguments="desktop -copy-link"
            WorkingDirectory="INSTALLFOLDER"
            Icon="MailArchiveIcon"
            Advertise="no" />

        <Shortcut
            Id="UninstallShortcut"
            Directory="ApplicationProgramsFolder"
            Name="Uninstall MailArchive Desktop"
            Description="Uninstall MailArchive Desktop"
            Target="[System64Folder]msiexec.exe"
            Arguments="/x [ProductCode]"
            WorkingDirectory="INSTALLFOLDER"
            Advertise="no" />

        <RemoveFolder Id="RemoveProgramMenuFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DocsDir">
      <!-- Explicit, stable GUID (same LGHT0367 rule as CmpDeploymentDocs): this is a
           multi-file component and the docs are unversioned. -->
      <Component Id="CmpUserDocs" Guid="B8D11E63-6C74-4AF7-AE62-42D1079C803B" Win64="yes">
        <File Id="FilLicense" Source="$(var.SourceDir)\docs\LICENSE.txt" KeyPath="yes" />
        <File Id="FilReleaseNotes" Source="$(var.SourceDir)\docs\release-notes.md" />
        <File Id="FilGoback" Source="$(var.SourceDir)\docs\goback.md" />
        <File Id="FilGraphSetup" Source="$(var.SourceDir)\docs\graph-app-setup.md" />
        <RemoveFolder Id="RemoveDocsFolder" Directory="DocsDir" On="uninstall" />
      </Component>
    </DirectoryRef>

    <Feature Id="MainFeature" Title="MailArchive Desktop" Level="1">
      <ComponentRef Id="CmpEngineExe" />
      <ComponentRef Id="CmpGuiwExe" />
      <ComponentRef Id="CmpDesktopCopyExe" />
      <ComponentRef Id="CmpGuiCopyExe" />
      <ComponentRef Id="CmpBrandAssets" />
      <ComponentRef Id="CmpDeploymentDocs" />
      <ComponentRef Id="CmpShortcutsAndDetection" />
      <ComponentRef Id="CmpUserDocs" />
    </Feature>
  </Product>
</Wix>
