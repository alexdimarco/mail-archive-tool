#!/bin/sh
# go vet ./... for darwin, linux and windows in one call, through the session's Go wrapper.
# usage: vet3 <module dir>
S=/private/tmp/claude-503/-Users-alex-dimarco-repositories/86c4cdf3-3c8e-4270-a184-12f76f0288e7/scratchpad
if [ "$#" -ne 1 ]; then
	echo "usage: vet3 <module dir>" >&2
	exit 2
fi
rc=0
for os in darwin linux windows; do
	echo "== GOOS=$os go vet ./..."
	GOOS=$os "$S/gobin/go" -C "$1" vet ./... || rc=1
done
if [ "$rc" -eq 0 ]; then
	echo "vet3: clean on darwin, linux and windows"
else
	echo "vet3: FAILED on at least one OS (see above)"
fi
exit $rc
